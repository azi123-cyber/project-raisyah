{
  "name": "siprama-man11",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "expo:start": "npm --prefix mobile run start",
    "expo:tunnel": "cd mobile && npx expo start --tunnel",
    "expo:android": "npm --prefix mobile run android",
    "expo:ios": "npm --prefix mobile run ios",
    "clean": "rm -rf dist server.js",
    "build:apk": "npm run build && rm -rf android-app/app/src/main/assets/dist && cp -r dist android-app/app/src/main/assets/dist && cd android-app && ./gradlew assembleRelease --no-daemon && cp app/build/outputs/apk/release/app-release.apk ../SIPRAMA.apk",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
